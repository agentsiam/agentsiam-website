# Copy to .env.local for development. In production these are set in the Vercel
# project's Environment Variables, never committed.

# Lets a preview deployment advertise its own URL in canonicals and OG tags.
# Leave unset in production, site.ts falls back to https://www.agentsiam.com
NEXT_PUBLIC_SITE_URL=

# Resend API key, used by /api/contact to deliver enquiries. Without it the form
# returns an error telling the visitor to email us directly.
RESEND_API_KEY=

# Where enquiries land. Defaults to CONTACT_EMAIL in site.ts if unset.
CONTACT_TO_EMAIL=hi@agentsiam.com

# The From address on enquiry notifications. Must be on a domain verified in
# Resend, which means adding Resend's DKIM records to the DNS zone. Note the
# zone also carries Zoho's SPF record, so the SPF entry must be merged, not
# replaced: one TXT record, both includes.
CONTACT_FROM_EMAIL="AgentSiam <noreply@agentsiam.com>"

# Beds24 hosted booking widget URL from the dashboard's Booking Widget ->
# Iframe Generator. Unset renders an enquiry call to action instead of a frame.
NEXT_PUBLIC_BEDS24_WIDGET_URL=
