# Copy to .env.local for development. In production these are set in the Vercel
# project's Environment Variables, never committed.

# Lets a preview deployment advertise its own URL in canonicals and OG tags.
# Leave unset in production, site.ts falls back to https://www.agentsiam.com
NEXT_PUBLIC_SITE_URL=

# -- Outgoing mail ------------------------------------------------------------
#
# src/lib/mailer.ts picks a transport from what is set here: SMTP if the SMTP_*
# variables are present, otherwise Resend. Setting neither means enquiries are logged
# as errors and not delivered.
#
# This site sends over SMTP because Resend cannot verify agentsiam.com while the domain
# stays at Wix -- Wix will not create the subdomain MX record Resend needs, and will not
# let you change nameservers. See DNS-EMAIL-RUNBOOK.md.

# Zoho, EU tenant. Note .eu -- smtp.zoho.com is a different tenant and will reject the
# login. Port 465 is implicit TLS; use 587 for STARTTLS.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465

# The full Zoho mailbox address that authenticates.
SMTP_USER=

# An app-specific password from accounts.zoho.eu -> Security -> App Passwords.
# NOT the account password: Zoho enforces 2FA and rejects the real one over SMTP.
SMTP_PASSWORD=

# Only needed if the domain is ever moved off Wix and Resend is verified. Leave unset
# while SMTP is in use -- SMTP takes precedence anyway.
RESEND_API_KEY=

# Where enquiries land. Defaults to CONTACT_EMAIL in site.ts if unset.
CONTACT_TO_EMAIL=hi@agentsiam.com

# The From address on notifications.
#
# On Zoho this is not free text: Zoho rejects any From that is not the authenticating
# mailbox or one of its aliases, so `noreply@` only works if it actually exists in Zoho.
# Leave this unset and the mailer uses SMTP_USER, which is always valid.
CONTACT_FROM_EMAIL=

# Beds24 refresh token. THE ONE SECRET the booking panel needs: it has write scope on
# the whole Beds24 account, so it is server-side only and must never be prefixed
# NEXT_PUBLIC_. The property and room IDs are not secrets and live in src/lib/property.ts.
#
# Get one from the Beds24 dashboard (Settings -> Apps & Integrations -> API), generate
# an invite code with read + write booking scopes, then exchange it once:
#
#   curl -s -H "code: <INVITE_CODE>" https://api.beds24.com/v2/authentication/setup
#
# The `refreshToken` in the response is the durable one. It does not expire while it is
# used at least once every 30 days. The `token` beside it is the 24-hour one, which the
# site mints for itself and does not need here.
#
# Unset: /api/booking/* answers 503 and the property page shows an enquiry call to
# action instead of a calendar.
BEDS24_REFRESH_TOKEN=

# Shared secret for /api/booking/webhook, which Beds24 calls when the allotment moves.
# Any random string; set the same value in the Beds24 property's webhook settings as a
# custom header, one line: `x-webhook-secret: <the same value>`.
#
# This is what makes the calendar real-time across the six channels the property is sold
# on. Unset, the route refuses every call and the calendar falls back to its 30-second
# TTL, which is a degradation and not a breakage.
BEDS24_WEBHOOK_SECRET=

# Lets a non-production environment write to Beds24. Leave unset.
#
# There is one Beds24 account and it is live: no sandbox, no test mode. So without this,
# preview deployments and local dev refuse to create holds, bookings or cancellations,
# because those block real nights across all six channels the property sells on. Reads are
# unaffected, so a preview still shows a live calendar and real prices.
#
# Set it to 1 only for the end-to-end test booking, then unset it. Production never needs
# it: VERCEL_ENV is "production" there and nowhere else.
BEDS24_ALLOW_WRITES=

# -- Stripe, for instant booking ---------------------------------------------
#
# Payment is taken on this site's own domain, so Beds24 never appears in the front end
# and no Beds24 payment gateway needs enabling. Card details go from the guest's browser
# straight to Stripe via the Payment Element and never reach this server, which keeps the
# site in the lightest PCI bracket (SAQ-A).
#
# Use test keys (sk_test_ / pk_test_) until the flow has been through end to end.

# Server side. Secret: never prefix this NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Sent to the browser. Safe to expose, and it is the switch for the whole paid path:
# unset, the property page offers "request to book" only and no payment is advertised.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret for /api/stripe/webhook, from the Stripe dashboard's webhook endpoint
# (or `stripe listen` in development, which prints its own whsec_...).
#
# This is load-bearing, not optional. The webhook is the ONLY thing that confirms a paid
# booking -- the browser is never trusted to say the money moved -- so without this every
# payment succeeds in Stripe and no booking is ever confirmed in Beds24.
#
# Subscribe the endpoint to: payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.canceled
STRIPE_WEBHOOK_SECRET=

# REQUIRED IN PRODUCTION, despite looking optional.
#
# Vercel only attaches `Authorization: Bearer $CRON_SECRET` to a scheduled request when
# this is set on the project. Unset, the cron in vercel.json reaches
# /api/booking/release-holds with no auth header, gets a 401, and abandoned checkouts
# keep their nights blocked on every channel — a silent failure, because nothing watches
# a job that never runs. Any random string.
CRON_SECRET=

# -- Maps ---------------------------------------------------------------------
#
# Every map on the site, the property search results and the guest local guide, is one
# component reading this. Unset, tiles come from OpenStreetMap's public servers, which
# their usage policy says are for development and low volume rather than production
# traffic: fine for a clone of this repo, not fine for guests.
#
# Free tier at maptiler.com is far more than this site needs. The key is publishable by
# design and ships in the browser bundle, so it is NEXT_PUBLIC_. What actually protects
# the quota is restricting the key to agentsiam.com and the Vercel preview domains in
# MapTiler's dashboard, not hiding it.
NEXT_PUBLIC_MAPTILER_KEY=

# -- WhatsApp -----------------------------------------------------------------
#
# Digits only, country code, no plus or spaces: 66812345678, not +66 81 234 5678.
#
# Where guest enquiries from the local guide land. The guide is deliberately shareable
# with people who have not booked, so it needs a way to start a conversation, and in
# Thailand that is WhatsApp or LINE rather than a form.
#
# Unset hides every WhatsApp call to action. That is on purpose: a wa.me link to no number
# opens WhatsApp to nothing, which is worse than no button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
