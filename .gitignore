# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Camera originals. The working copies beside them are capped at 2560px, which is still
# double what the largest slot on the site renders; these are the untouched 4000px files,
# kept for print or a future redesign. ~366MB and growing, so they stay out of git --
# the folder still syncs to Google Drive, which is where the backup actually lives.
src/photos/**/raw/

# The example is documentation of every variable the app reads, not a secret.
# Real values live in .env.local and in the Vercel project. Keep it tracked.
!.env.example
